            grid.innerHTML = '';

            GD_DATABASE.forEach((section, idx) => {
                // Calculate section stats
                let sectionCorrect = 0;
                let sectionAttempted = 0;
                section.questions.forEach(q => {
                    const record = userScores[q.id];
                    if (record) {
                        sectionAttempted++;
                        if (record.correct) sectionCorrect++;
                    }
                });

                const progressPercent = Math.round((sectionAttempted / 10.0) * 100);
                const isCompleted = sectionCorrect === 10;

                const card = document.createElement('div');
                card.className = "bg-slate-900 border border-slate-800 rounded-2xl p-5 hover:border-slate-700 transition-all duration-200 flex flex-col justify-between space-y-4";
                card.innerHTML = `
                    <div class="space-y-2">
                        <div class="flex items-start justify-between">
                            <div class="p-2.5 bg-teal-500/10 text-teal-400 rounded-xl">
                                <i data-lucide="${section.icon || 'book-open'}" class="w-5 h-5"></i>
                            </div>
                            <span class="text-xs font-mono font-semibold ${isCompleted ? 'text-emerald-400' : 'text-slate-500'}">
                                ${sectionCorrect}/10 CORRECT
                            </span>
                        </div>
                        <h4 class="font-bold text-white text-base sm:text-lg">${idx + 1}. ${section.title}</h4>
                        <p class="text-xs text-slate-400 leading-relaxed">${section.description}</p>
                    </div>

                    <div class="space-y-3 pt-2">
                        <div class="space-y-1">
                            <div class="flex justify-between text-[10px] font-mono text-slate-400">
                                <span>PROGRESS</span>
                                <span>${progressPercent}%</span>
                            </div>
                            <div class="h-1.5 w-full bg-slate-950 rounded-full overflow-hidden">
                                <div class="h-full bg-gradient-to-r from-teal-500 to-emerald-400 rounded-full" style="width: ${progressPercent}%"></div>
                            </div>
                        </div>

                        <button onclick="loadSection(${idx})" class="w-full py-2 bg-slate-950 hover:bg-teal-500 hover:text-slate-950 text-teal-400 border border-teal-500/20 font-semibold text-xs rounded-xl tracking-wider uppercase transition-all duration-200">
                            ${sectionAttempted > 0 ? 'Resume Training' : 'Start Lesson'}
                        </button>
                    </div>
                `;
                grid.appendChild(card);
            });
            lucide.createIcons();
        }

        function goToHome() {
            document.getElementById('quiz-view').classList.add('hidden');
            document.getElementById('home-view').classList.remove('hidden');
            activeSectionIndex = null;
            renderTOC();
            updateScoreboard();
        }

        // Active Quiz Logic
        function loadSection(sectionIdx) {
            activeSectionIndex = sectionIdx;
            activeQuestionIndex = 0;

            const section = GD_DATABASE[sectionIdx];

            document.getElementById('home-view').classList.add('hidden');
            document.getElementById('quiz-view').classList.remove('hidden');

            document.getElementById('quiz-section-title').textContent = `${sectionIdx + 1}. ${section.title}`;
            document.getElementById('total-q-count').textContent = section.questions.length;

            loadQuestion();
            loadInterviewQuestions();
        }

        function loadQuestion() {
            const section = GD_DATABASE[activeSectionIndex];
            const q = section.questions[activeQuestionIndex];

            document.getElementById('current-q-index').textContent = activeQuestionIndex + 1;
            document.getElementById('question-id-badge').textContent = `#Q${q.id}`;
            document.getElementById('question-difficulty').textContent = `LEVEL: ${q.difficulty}`;

            // Adjust difficulty color indicator
            const diffBadge = document.getElementById('question-difficulty');
            if (q.difficulty === 'EASY') {
                diffBadge.className = "px-2.5 py-1 rounded-md text-[10px] font-mono font-bold tracking-wider bg-sky-500/10 text-sky-400 border border-sky-500/20";
            } else {
                diffBadge.className = "px-2.5 py-1 rounded-md text-[10px] font-mono font-bold tracking-wider bg-teal-500/10 text-teal-400 border border-teal-500/20";
            }

            // Set question text
            document.getElementById('question-text').innerHTML = q.text;

            // Load options
            const optionsBox = document.getElementById('options-container');
            optionsBox.innerHTML = '';

            const record = userScores[q.id] || { answered: false, correct: false, attempts: [] };

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = "w-full text-left p-4 rounded-xl border transition-all duration-200 text-sm font-medium flex items-center justify-between gap-3 ";
                
                // Set baseline state classes
                if (record.correct && record.selectedIdx === idx) {
                    // Correct state
                    btn.className += "bg-emerald-500/10 border-emerald-500 text-emerald-400 premium-glow-success";
                    btn.innerHTML = `<span>${opt}</span> <i data-lucide="check-circle" class="w-5 h-5 text-emerald-400 shrink-0"></i>`;
                } else if (!record.correct && record.attempts && record.attempts.includes(idx)) {
                    // Incorrect attempt state
                    btn.className += "bg-rose-500/5 border-rose-500/40 text-rose-400/80 cursor-not-allowed";
                    btn.innerHTML = `<span>${opt}</span> <i data-lucide="x-circle" class="w-5 h-5 text-rose-400 shrink-0"></i>`;
                } else {
                    // Default interactive state
                    btn.className += "bg-slate-950/60 border-slate-800 text-slate-300 hover:border-slate-700 hover:bg-slate-950";
                    btn.innerHTML = `<span>${opt}</span> <span class="w-5 h-5 rounded-full border border-slate-700 shrink-0 flex items-center justify-center text-[10px] text-slate-500 font-mono">${String.fromCharCode(65 + idx)}</span>`;
                    btn.onclick = (e) => selectOption(idx, e);
                }

                optionsBox.appendChild(btn);
            });

            // Set up feedback panel state
            const feedbackPanel = document.getElementById('feedback-panel');
            if (record.correct) {
                feedbackPanel.classList.remove('hidden');
                feedbackPanel.className = "rounded-2xl p-5 border bg-emerald-950/20 border-emerald-500/30 text-emerald-300";
                document.getElementById('feedback-icon-wrapper').className = "p-2 rounded-xl bg-emerald-500/10 text-emerald-400";
                document.getElementById('feedback-icon').setAttribute('data-lucide', 'badge-check');
                document.getElementById('feedback-heading').textContent = "EXCELLENT JOB!";
                document.getElementById('feedback-text').innerHTML = `<strong>Correct.</strong> ${q.hint} All geometry alignments are secure.`;
            } else if (record.attempts && record.attempts.length > 0) {
                feedbackPanel.classList.remove('hidden');
                feedbackPanel.className = "rounded-2xl p-5 border bg-amber-950/10 border-amber-500/30 text-amber-300";
                document.getElementById('feedback-icon-wrapper').className = "p-2 rounded-xl bg-amber-500/10 text-amber-400";
                document.getElementById('feedback-icon').setAttribute('data-lucide', 'help-circle');
                document.getElementById('feedback-heading').textContent = "HINT & DEDUCTION AID";
                document.getElementById('feedback-text').innerHTML = `<strong>Physical Clue:</strong> ${q.hint}`;
            } else {
                feedbackPanel.classList.add('hidden');
            }

            // Progress Bar alignment
            const sectionPercent = Math.round(((activeQuestionIndex + 1) / section.questions.length) * 100);
            document.getElementById('section-progress-bar').style.width = `${sectionPercent}%`;

            // Dots Navigation Generator
            const dotsContainer = document.getElementById('question-navigator-dots');
            dotsContainer.innerHTML = '';
            section.questions.forEach((_, dotIdx) => {
                const dot = document.createElement('button');
                dot.onclick = () => jumpToQuestion(dotIdx);
                const qRecord = userScores[section.questions[dotIdx].id];
                
                let dotClass = "w-2.5 h-2.5 rounded-full transition-all duration-150 ";
                if (dotIdx === activeQuestionIndex) {
                    dotClass += "bg-teal-400 ring-2 ring-teal-500/40 scale-125";
                } else if (qRecord && qRecord.correct) {
                    dotClass += "bg-emerald-500";
                } else if (qRecord && qRecord.attempts.length > 0) {
                    dotClass += "bg-rose-500";
                } else {
                    dotClass += "bg-slate-700 hover:bg-slate-600";
                }
                
                dot.className = dotClass;
                dotsContainer.appendChild(dot);
            });

            // Standard Navigation disabled locks
            document.getElementById('prev-btn').disabled = activeQuestionIndex === 0;
            document.getElementById('next-btn').disabled = activeQuestionIndex === section.questions.length - 1;

            lucide.createIcons();
            renderMathInElement();
        }

        function selectOption(idx, event) {
            const section = GD_DATABASE[activeSectionIndex];
            const q = section.questions[activeQuestionIndex];
            
            if (!userScores[q.id]) {
                userScores[q.id] = { answered: false, correct: false, attempts: [] };
            }

            const record = userScores[q.id];
            if (record.correct) return; // locked

            if (idx === q.correct) {
                record.correct = true;
                record.answered = true;
                record.selectedIdx = idx;
                triggerSparks(event);
            } else {
                if (!record.attempts.includes(idx)) {
                    record.attempts.push(idx);
                }
            }

            saveProgress();
            loadQuestion();
            updateScoreboard();
        }

        function previousQuestion() {
            if (activeQuestionIndex > 0) {
                activeQuestionIndex--;
                loadQuestion();
            }
        }

        function nextQuestion() {
            const section = GD_DATABASE[activeSectionIndex];
            if (activeQuestionIndex < section.questions.length - 1) {
                activeQuestionIndex++;
                loadQuestion();
            }
        }

        function jumpToQuestion(idx) {
            activeQuestionIndex = idx;
            loadQuestion();
        }

        // Render Interview Preparation Cards
        function loadInterviewQuestions() {
            const section = GD_DATABASE[activeSectionIndex];
            const container = document.getElementById('interview-cards-container');
            container.innerHTML = '';

            section.interviewQuestions.forEach((iq, iIdx) => {
                const card = document.createElement('div');
                card.className = "bg-slate-950 p-4 rounded-2xl border border-slate-800/80 space-y-3";
                card.innerHTML = `
                    <div class="flex items-start gap-2.5">
                        <span class="text-xs font-mono text-emerald-400 font-bold bg-emerald-500/10 px-2 py-0.5 rounded">INT-${iIdx + 1}</span>
                        <h5 class="text-xs sm:text-sm font-semibold text-slate-200 leading-snug">${iq.question}</h5>
                    </div>
                    
                    <button id="int-reveal-btn-${iIdx}" onclick="toggleInterviewAnswer(${iIdx})" class="text-[10px] tracking-wider font-mono font-bold uppercase text-teal-400 hover:text-teal-300 transition-colors flex items-center gap-1">
                        Reveal Industry Standard Answer <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>
                    </button>

                    <div id="int-answer-box-${iIdx}" class="hidden text-xs text-slate-400 leading-relaxed bg-slate-900/60 p-3 rounded-xl border border-slate-800 font-serif">
                        ${iq.answer}
                    </div>
                `;
                container.appendChild(card);
            });
            lucide.createIcons();
            renderMathInElement();
        }

        function toggleInterviewAnswer(idx) {
            const box = document.getElementById(`int-answer-box-${idx}`);
            const btn = document.getElementById(`int-reveal-btn-${idx}`);
            if (box.classList.contains('hidden')) {
                box.classList.remove('hidden');
                btn.innerHTML = `Hide Answer <i data-lucide="chevron-up" class="w-3.5 h-3.5"></i>`;
            } else {
                box.classList.add('hidden');
                btn.innerHTML = `Reveal Industry Standard Answer <i data-lucide="chevron-down" class="w-3.5 h-3.5"></i>`;
            }
            lucide.createIcons();
        }

        // Automated rendering helper for latex expressions using KaTeX
        function renderMathInElement() {
            if (typeof katex !== 'undefined') {
                const targets = document.querySelectorAll('#quiz-view h4, #quiz-view p, #quiz-view span, #quiz-view div, #interview-cards-container div');
                targets.forEach(el => {
                    const html = el.innerHTML;
                    // Replace standard $..$ formatting safely with KaTeX rendering
                    if (html && html.includes('$')) {
                        const replaced = html.replace(/\$([^\$]+)\$/g, (match, expression) => {
                            try {
                                return katex.renderToString(expression, { throwOnError: false });
                            } catch (err) {
                                return match;
                            }
                        });
                        el.innerHTML = replaced;
                    }
                });
            }
        }
    </script>
</body>
</html>

