            });

            document.getElementById('global-completed-text').textContent = `${totalAnswered}/100`;
            const accuracy = totalAnswered > 0 ? Math.round((totalCorrect / totalAnswered) * 100) : 0;
            document.getElementById('global-accuracy-text').textContent = `${accuracy}%`;
        }

